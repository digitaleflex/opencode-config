{
  "$schema": "https://opencode.ai/config.json",
  "shell": "bash",

  // ── Plugins (canonical list — opencode.json must NOT re-declare) ──
  "plugin": [
    "opencode-dynamic-context-pruning",
    "opencode-mem",
    "envsitter-guard",
    "oh-my-opencode-slim",
    "opencode-router",
    "opencode.nvim",
    "./plugin/guard.ts",
    "./plugin/audit-logger.ts",
    "@felipegenef/opencode-lazy-skills",
    "@f97/opencode-morph-fast-apply",
    "opencode-supermemory",
    "@zenobius/opencode-skillful",
    "oh-my-openagent",
    "./plugin/context-summarizer.ts"
  ],

  // ── Permissions globales ──
  "permission": {
    "skill": "allow",

    // Bash : allow lecture/build/tools ; ask modif réseau ; deny destructeur
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rm -rf *": "deny",
      "mkfs *": "deny",
      "dd if=*": "deny",
      "git push*": "ask",
      "git push --force*": "deny",
      "git reset --hard*": "ask",
      "npm publish*": "ask",
      "curl *|*sh": "ask"
    }
  },

  // ── Modèle par défaut : EURINHASH (superviseur FREE) ──
  "default_agent": "eurinhash",
  "small_model": "mistral/mistral-code-latest",
  "formatter": true,
  "lsp": true,

  // ── MCP ──
  "mcp": {
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@database-mcp/postgres"],
      "environment": {
        "DATABASE_URL": "{env:DATABASE_URL}"
      },
      "enabled": true
    }
  },

  // ── Providers FREE uniquement ──
  "provider": {
    "zhipu": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI GLM (FREE)",
      "options": {
        "baseURL": "https://api.z.ai/api/paas/v4",
        "apiKey": "{file:~/.config/opencode/.zhipu-key}"
      },
      "models": {
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash (FREE)"
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash (FREE)"
        }
      }
    },

    "google": {
      "npm": "@ai-sdk/google",
      "name": "Google Gemini (FREE)",
      "options": {
        "apiKey": "{file:~/.config/opencode/.gemini-key}",
        "timeout": 300000,
        "headerTimeout": 90000,
        "chunkTimeout": 60000
      },
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (FREE)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "options": {
            "maxRetries": 3,
            "safetySettings": [
              { "category": "HARM_CATEGORY_DANGEROUS_CONTENT",  "threshold": "BLOCK_ONLY_HIGH" },
              { "category": "HARM_CATEGORY_HARASSMENT",       "threshold": "BLOCK_ONLY_HIGH" },
              { "category": "HARM_CATEGORY_HATE_SPEECH",        "threshold": "BLOCK_ONLY_HIGH" },
              { "category": "HARM_CATEGORY_SEXUALLY_EXPLICIT", "threshold": "BLOCK_ONLY_HIGH" }
            ]
          }
        },
        "gemini-3.8-flash": {
          "name": "Gemini 3.8 Flash (FREE)"
        },
        "gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash (FREE)"
        },
        "gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash (FREE)"
        },
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash (FREE)"
        },
        "gemini-flash-latest": {
          "name": "Gemini Flash Latest (FREE)"
        }
      }
    },

    "mistral": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Mistral (FREE)",
      "options": {
        "baseURL": "https://api.mistral.ai/v1",
        "apiKey": "{file:~/.config/opencode/.mistral-key}"
      },
      "models": {
        "codestral-latest": {
          "name": "Codestral (FREE, testé OK)"
        },
        "mistral-code-latest": {
          "name": "Mistral Code (FREE, testé OK)"
        }
      }
    },

    "groq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Groq (FREE)",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "{file:~/.config/opencode/.groq-key}"
      },
      "models": {
        "qwen/qwen3.8-27b": {
          "name": "Qwen 3.8 27B (FREE, testé OK)"
        },
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B (FREE)"
        },
        "openai/gpt-oss-20b": {
          "name": "GPT-OSS 20B (FREE)"
        },
        "qwen/qwen3.6-27b": {
          "name": "Qwen 3.6 27B (FREE)"
        }
      }
    },

    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (FREE)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{file:~/.config/opencode/.openrouter-key}"
      },
      "models": {
        "openrouter/free": {
          "name": "Free Router (auto, FREE)",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "inclusionai/ling-3.0-flash-sante:free": {
          "name": "Ling 3.0 Flash Santé (100% GRATUIT, 256K ctx)"
        },
        "meta-llama/muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 (1M ctx, $0.10/M)"
        }
      }
    },

    "huggingface": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Hugging Face (FREE)",
      "options": {
        "baseURL": "https://router.huggingface.co/v1",
        "apiKey": "{file:~/.config/opencode/.hf-key}"
      },
      "models": {
        "Qwen/Qwen3-Coder-480B-A35B-Instruct:cheapest": {
          "name": "Qwen3 Coder 480B (FREE)"
        },
        "deepseek-ai/DeepSeek-V4-Flash:cheapest": {
          "name": "DeepSeek V4 Flash (FREE)"
        }
      }
    },

    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek Direct (API native, prompt caching)",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{file:~/.config/opencode/.deepseek-key}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash ($0.14/M, $0.03/M cached, 1M ctx)"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (raisonnement avancé, 128K ctx)"
        }
      }
    },

    "novita": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Novita AI (bon marché + gratuit)",
      "options": {
        "baseURL": "https://api.novita.ai/openai/v1",
        "apiKey": "{file:~/.config/opencode/.novita-key}"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4-Flash": {
          "name": "DeepSeek V4 Flash ($0.14/M input, $0.03/M cached, 1M ctx)"
        },
        "deepseek-ai/GLM-5-Flash": {
          "name": "GLM 5 Flash ($0.075/M, 1M ctx)"
        },
        "inclusionai/ling-3.0-flash-fin": {
          "name": "Ling 3.0 Flash Fin (GRATUIT, 256K ctx)"
        },
        "inclusionai/ling-3.0-flash-sante": {
          "name": "Ling 3.0 Flash Santé (GRATUIT, 256K ctx)"
        }
      }
    },

    "together": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Together AI (spécialisé code)",
      "options": {
        "baseURL": "https://api.together.xyz/v1",
        "apiKey": "{file:~/.config/opencode/.together-key}"
      },
      "models": {
        "moonshotai/Kimi-K2.7-Code": {
          "name": "Kimi K2.7 Code (spécialisé code, 256K ctx)"
        },
        "meta-llama/Llama-4-Maverick": {
          "name": "Llama 4 Maverick (1M ctx, $0.27/M)"
        },
        "deepseek-ai/DeepSeek-V4-Pro": {
          "name": "DeepSeek V4 Pro (raisonnement avancé, 1M ctx)"
        }
      }
    },

    // ── Nouveaux providers gratuits (v0.8.0) — voir docs/02-configuration.md §3.6 ──
    "sambanova": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SambaNova (FREE, gros modèles rapides)",
      "options": {
        "baseURL": "https://api.sambanova.ai/v1",
        "apiKey": "{file:~/.config/opencode/.sambanova-key}"
      },
      "models": {
        "Meta-Llama-3.3-70B-Instruct": {
          "name": "Llama 3.3 70B (FREE, 20 req/jour)"
        },
        "DeepSeek-V3.1": {
          "name": "DeepSeek V3.1 (FREE, 20 req/jour, bon en code)"
        },
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B (FREE, 20 req/jour)"
        }
      }
    },

    "pollinations": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Pollinations (FREE, sans clé)",
      "options": {
        "baseURL": "https://text.pollinations.ai/openai",
        // Tier anonyme : aucune vraie clé requise (1 req/15s). Compte gratuit
        // sur auth.pollinations.ai pour des limites supérieures.
        "apiKey": "anonymous"
      },
      "models": {
        "openai": {
          "name": "Auto (FREE, sans clé, backup ultime)"
        }
      }
    },

    "cerebras": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cerebras (TRIAL $5, ultra-rapide)",
      "options": {
        "baseURL": "https://api.cerebras.ai/v1",
        "apiKey": "{file:~/.config/opencode/.cerebras-key}"
      },
      "models": {
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B (TRIAL, 1M tokens/jour)"
        },
        "llama3.1-8b": {
          "name": "Llama 3.1 8B (TRIAL, ~2000 tok/s)"
        }
      }
    },

    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local, 100% gratuit, offline)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        // Ollama local n'exige aucune clé ; valeur factice pour le SDK.
        "apiKey": "ollama"
      },
      "models": {
        "devstral": {
          "name": "Devstral (local, agentique code)"
        },
        "qwen2.5-coder": {
          "name": "Qwen2.5-Coder (local, code)"
        },
        "llama3.1": {
          "name": "Llama 3.1 (local, générique)"
        }
      }
    }
  }
}
