{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg0": "#080C14",
    "bg1": "#0B101B",
    "bg2": "#0A0F19",
    "bg3": "#0B111C",
    "lime": "#C5F441",
    "limeDim": "#A8E637",
    "limeSoft": "#B8F23A",
    "blue": "#5F8FC7",
    "blue2": "#6D9BD0",
    "blue3": "#7DA8D8",
    "textMain": "#D8E0EA",
    "text2": "#C9D3DF",
    "muted": "#718096",
    "muted2": "#7D8A9C",
    "dim": "#647184",
    "green": "#4ADE80",
    "amber": "#FBBF24",
    "red": "#F87171",
    "cyan": "#38BDF8",
    "purple": "#A78BFA"
  },
  "theme": {
    "primary": { "dark": "lime", "light": "limeDim" },
    "secondary": { "dark": "blue2", "light": "blue" },
    "accent": { "dark": "lime", "light": "limeDim" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "amber", "light": "amber" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "cyan", "light": "blue" },

    "text": { "dark": "textMain", "light": "bg0" },
    "textMuted": { "dark": "muted", "light": "dim" },
    "selectedListItemText": { "dark": "lime", "light": "limeDim" },

    "background": { "dark": "bg0", "light": "textMain" },
    "backgroundPanel": { "dark": "bg1", "light": "text2" },
    "backgroundElement": { "dark": "bg2", "light": "muted2" },
    "backgroundMenu": { "dark": "bg3", "light": "muted2" },

    "border": { "dark": "blue", "light": "blue" },
    "borderActive": { "dark": "lime", "light": "limeDim" },
    "borderSubtle": { "dark": "bg3", "light": "muted2" },

    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "blue2", "light": "blue" },
    "diffHighlightAdded": { "dark": "lime", "light": "limeDim" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "bg2", "light": "muted2" },
    "diffRemovedBg": { "dark": "bg2", "light": "muted2" },
    "diffContextBg": { "dark": "bg1", "light": "text2" },
    "diffLineNumber": { "dark": "dim", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "bg2", "light": "muted2" },
    "diffRemovedLineNumberBg": { "dark": "bg2", "light": "muted2" },

    "markdownText": { "dark": "textMain", "light": "bg0" },
    "markdownHeading": { "dark": "lime", "light": "limeDim" },
    "markdownLink": { "dark": "blue2", "light": "blue" },
    "markdownLinkText": { "dark": "blue3", "light": "blue2" },
    "markdownCode": { "dark": "limeSoft", "light": "limeDim" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "blue2", "light": "blue" },
    "markdownStrong": { "dark": "lime", "light": "limeDim" },
    "markdownHorizontalRule": { "dark": "blue", "light": "blue" },
    "markdownListItem": { "dark": "blue2", "light": "blue" },
    "markdownListEnumeration": { "dark": "blue3", "light": "blue2" },
    "markdownImage": { "dark": "blue2", "light": "blue" },
    "markdownImageText": { "dark": "muted", "light": "muted" },
    "markdownCodeBlock": { "dark": "limeSoft", "light": "limeDim" },

    "syntaxComment": { "dark": "dim", "light": "muted" },
    "syntaxKeyword": { "dark": "lime", "light": "limeDim" },
    "syntaxFunction": { "dark": "blue3", "light": "blue" },
    "syntaxVariable": { "dark": "text2", "light": "bg0" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "amber", "light": "amber" },
    "syntaxType": { "dark": "cyan", "light": "blue" },
    "syntaxOperator": { "dark": "blue2", "light": "blue" },
    "syntaxPunctuation": { "dark": "muted", "light": "muted" },

    "thinkingOpacity": 0.6
  }
}