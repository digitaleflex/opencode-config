{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "tokyonight",
  "plugin": [
    [
      "./plugins/opencode-statusline.tsx",
      {
        "locale": "fr",
        "lines": [
          [
            { "type": "model", "color": "accent", "bold": true },
            { "type": "separator" },
            { "type": "advisor", "bold": true },
            { "type": "separator" },
            { "type": "tokens" },
            { "type": "separator" },
            { "type": "context-pct" },
            { "type": "context-bar" }
          ],
          [
            { "type": "mode", "bold": true },
            { "type": "separator" },
            { "type": "provider-health", "color": "success" },
            { "type": "separator" },
            { "type": "routing-chain", "color": "info" },
            { "type": "separator" },
            { "type": "risk-level", "color": "warning" }
          ],
          [
            { "type": "cost", "color": "warning" },
            { "type": "separator" },
            { "type": "quota-bar", "color": "success" },
            { "type": "separator" },
            { "type": "budget", "color": "info" },
            { "type": "separator" },
            { "type": "git-branch" }
          ],
          [
            { "type": "burn", "color": "info" },
            { "type": "separator" },
            { "type": "context-guard" }
          ],
          [
            { "type": "reasoning" },
            { "type": "separator" },
            { "type": "total-tokens" },
            { "type": "separator" },
            { "type": "cache-hit-rate" }
          ],
          [
            { "type": "provider-health" },
            { "type": "separator" },
            { "type": "routing-chain" },
            { "type": "separator" },
            { "type": "quota-bar" },
            { "type": "separator" },
            { "type": "audit-tail" }
          ],
          [
            { "type": "sensitive-ops" },
            { "type": "separator" },
            { "type": "risk-level" },
            { "type": "separator" },
            { "type": "budget" }
          ]
        ]
      }
    ],
    "@tarquinen/opencode-dcp@latest"
  ]
}
