{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "eurinhash-command-center",

  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  },

  "diff_style": "stacked",
  "mouse": true,
  "scroll_speed": 3,

  "plugin": [
    [
      "./plugins/opencode-statusline.tsx",
      {
        "locale": "fr",
        "lines": [
          [
            { "type": "clock", "color": "accent", "bold": true },
            { "type": "separator" },
            { "type": "date" },
            { "type": "separator" },
            { "type": "model", "color": "accent", "bold": true },
            { "type": "separator" },
            { "type": "advisor", "bold": true },
            { "type": "separator" },
            { "type": "tokens" },
            { "type": "separator" },
            { "type": "context-pct" },
            { "type": "context-bar" }
          ],
          [
            { "type": "mode", "bold": true },
            { "type": "separator" },
            { "type": "provider-health", "color": "success" },
            { "type": "separator" },
            { "type": "routing-chain", "color": "info" },
            { "type": "separator" },
            { "type": "risk-level", "color": "warning" }
          ],
          [
            { "type": "cost", "color": "warning" },
            { "type": "separator" },
            { "type": "quota-bar", "color": "success" },
            { "type": "separator" },
            { "type": "budget", "color": "info" },
            { "type": "separator" },
            { "type": "git-branch" }
          ],
          [
            { "type": "burn", "color": "info" },
            { "type": "separator" },
            { "type": "context-guard" },
            { "type": "separator" },
            { "type": "messages" },
            { "type": "separator" },
            { "type": "duration" },
            { "type": "separator" },
            { "type": "speed" }
          ],
          [
            { "type": "reasoning" },
            { "type": "separator" },
            { "type": "total-tokens" },
            { "type": "separator" },
            { "type": "cache-hit-rate" },
            { "type": "separator" },
            { "type": "audit-tail" },
            { "type": "separator" },
            { "type": "sensitive-ops" }
          ]
        ]
      }
    ],
    "@tarquinen/opencode-dcp@latest"
  ]
}
